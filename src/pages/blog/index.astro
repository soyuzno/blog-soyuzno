---
import { getCollection } from 'astro:content';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="id">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{SITE_TITLE}</title>
		<meta name="description" content={SITE_DESCRIPTION} />
	</head>
	<body class="bg-white text-neutral-900 antialiased max-w-xl mx-auto px-6 py-16 font-sans">
		<!-- Header Sederhana ala Soyuzno -->
		<header class="flex justify-between items-center mb-16">
			<a href="/" class="font-medium text-neutral-900 hover:text-neutral-600 tracking-tight">Soyuzno</a>
			<nav class="space-x-6 text-sm text-neutral-500">
				<a href="https://soyuzno.com" class="hover:text-neutral-900 transition-colors">Work</a>
				<a href="/" class="text-neutral-900 font-medium">Blog</a>
			</nav>
		</header>

		<!-- Daftar Artikel Minimalis -->
		<main>
			<h1 class="text-xl font-medium tracking-tight mb-8 text-neutral-900">Notes & Articles</h1>
			<ul class="space-y-6">
				{
					posts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`} class="group block">
								<div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
									<span class="text-base font-normal text-neutral-900 group-hover:text-neutral-500 transition-colors">
										{post.data.title}
									</span>
									<span class="text-xs text-neutral-400 whitespace-nowrap">
										<time datetime={post.data.pubDate.toISOString()}>
											{post.data.pubDate.toLocaleDateString('id-ID', {
												year: 'numeric',
												month: 'short',
												day: 'numeric',
											})}
										</time>
									</span>
								</div>
							</a>
						</li>
					))
				}
			</ul>
		</main>

		<!-- Footer Bersih -->
		<footer class="mt-24 pt-8 border-t border-neutral-100 text-xs text-neutral-400 flex justify-between">
			<span>© 2026 Soyuzno</span>
			<div class="space-x-4">
				<a href="https://github.com/soyuzno" target="_blank" class="hover:text-neutral-600">GitHub</a>
				<a href="https://linkedin.com" target="_blank" class="hover:text-neutral-600">LinkedIn</a>
			</div>
		</footer>
	</body>
</html>