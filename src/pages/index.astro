---
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Blog — Soyuzno</title>
    
    <!-- Google Sans Flex -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Google+Sans+Flex:opsz,wght@6..144,1..1000&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --bg-color: #ffffff;
            --text-main: #111827;
            --text-muted: #6b7280;
            --border-color: #e5e7eb;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: "Google Sans Flex", sans-serif;
            background-color: var(--bg-color);
            color: var(--text-main);
            line-height: 1.6;
            -webkit-font-smoothing: antialiased;
        }

        a {
            color: inherit;
            text-decoration: none;
            transition: color 0.2s ease;
        }

        a:hover {
            color: var(--text-muted);
        }

        /* CONTAINER DENGAN GARIS VERTIKAL KIRI & KANAN */
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 4rem; 
            border-left: 1px solid var(--border-color); 
            border-right: 1px solid var(--border-color); 
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* NAVIGATION */
        nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 2rem 0;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            font-weight: 500;
            font-size: 1rem;
        }

        .logo-circle {
            width: 31px;
            height: 31px;
            background: #d1d5db;
            border-radius: 50%;
        }

        .nav-links {
            display: flex;
            gap: 2rem;
            font-size: 0.9rem;
            font-weight: 500;
        }

        .nav-links a.active {
            color: var(--text-main);
            border-bottom: 1px solid var(--text-main);
            padding-bottom: 0.1rem;
        }

        .nav-links a:not(.active) {
            color: var(--text-muted);
        }

        /* BLOG LIST SECTION */
        .blog-main {
            padding: 4rem 0;
            flex: 1;
            display: grid;
            grid-template-columns: repeat(12, 1fr);
            column-gap: 2rem;
        }

        .blog-content {
            grid-column: 3 / 11;
        }

        .blog-content h1 {
            font-size: 2.5rem;
            font-weight: 500;
            line-height: 1.1;
            letter-spacing: -0.02em;
            margin-bottom: 3rem;
        }

        .post-list {
            list-style: none;
        }

        .post-item {
            border-bottom: 1px solid var(--border-color);
            padding: 1.5rem 0;
        }

        .post-item:first-child {
            border-top: 1px solid var(--border-color);
        }

        .post-link {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            gap: 2rem;
        }

        .post-title {
            font-size: 1.125rem;
            font-weight: 500;
        }

        .post-date {
            font-size: 0.875rem;
            color: var(--text-muted);
            white-space: nowrap;
        }

        /* FOOTER */
        footer {
            margin: 0 -4rem;
            padding: 2rem 4rem;
            border-top: 1px solid var(--border-color);
            display: flex;
            justify-content: space-between;
            font-size: 0.875rem;
            color: var(--text-muted);
        }

        .footer-links {
            display: flex;
            gap: 1.5rem;
        }

        @media (max-width: 900px) {
            .blog-content {
                grid-column: 2 / 12;
            }
        }

        @media (max-width: 600px) {
            .container {
                border-left: none;
                border-right: none;
                padding: 0 1.5rem;
            }
            .nav-links {
                display: none;
            }
            .blog-content {
                grid-column: 1 / -1;
            }
            footer {
                margin: 0 -1.5rem;
                padding: 2rem 1.5rem;
                flex-direction: column;
                gap: 1rem;
                align-items: center;
                text-align: center;
            }
        }
    </style>
</head>
<body>

    <div class="container">
        <!-- HEADER / NAV -->
        <nav>
            <div class="logo">
                <div class="logo-circle"></div>
                Soyuzno
            </div>
            <div class="nav-links">
                <a href="https://soyuzno.com/#work">Work</a>
                <a href="https://soyuzno.com/#about">About</a>
                <a href="https://soyuzno.com/#contact">Contact</a>
                <a href="/" class="active">Blog</a>
            </div>
        </nav>

        <!-- BLOG LIST -->
        <main class="blog-main">
            <div class="blog-content">
                <h1>Notes & Articles</h1>
                <ul class="post-list">
                    {
                        posts.map((post) => (
                            <li class="post-item">
                                <a href={`/blog/${post.id}/`} class="post-link">
                                    <span class="post-title">{post.data.title}</span>
                                    <span class="post-date">
                                        <time datetime={post.data.pubDate.toISOString()}>
                                            {post.data.pubDate.toLocaleDateString('id-ID', {
                                                year: 'numeric',
                                                month: 'short',
                                                day: 'numeric',
                                            })}
                                        </time>
                                    </span>
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </div>
        </main>

        <!-- FOOTER -->
        <footer>
            <div class="footer-links">
                <a href="https://www.behance.net/soyuzno">Behance</a> /
                <a href="https://id.linkedin.com/in/soyuzno">LinkedIn</a> /
                <a href="https://x.com/soyuzno">X</a>
            </div>
            <div>Privacy Policy • &copy;2026</div>
        </footer>
    </div>

</body>
</html>
